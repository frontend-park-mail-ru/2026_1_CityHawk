        onerror="this.onerror=null;this.src='/public/static/img/concert.jpeg';"
      />
    </span>
    <h3 class="event-card__title">{{title}}</h3>

    {{#each textLines}}
      <p class="event-card__text">{{this}}</p>
    {{/each}}

    {{#if tags.length}}
      <div class="event-card__meta">
        <div class="event-card__tags-full">
          {{#each tags}}
            <span class="event-card__tag">{{this}}</span>
          {{/each}}
        </div>
        <div class="event-card__tags-mobile{{#if extraTagsCount}} event-card__tags-mobile--with-count{{/if}}">
          <span class="event-card__tag">{{primaryTag}}</span>
          {{#if extraTagsCount}}
            <span class="event-card__tag event-card__tag--count">+{{extraTagsCount}}</span>
          {{/if}}
        </div>
      </div>
    {{/if}}
  </div>
{{/if}}
