{{#if id}}
  <a href="/events/{{id}}" class="event-card {{cardClass}}">
    <button
      type="button"
      class="event-card__favorite{{#if isFavorite}} event-card__favorite--active{{/if}}"
      data-role="event-card-favorite"
      data-event-id="{{id}}"
      aria-label="{{#if isFavorite}}Убрать из избранного{{else}}Добавить в избранное{{/if}}"
      aria-pressed="{{#if isFavorite}}true{{else}}false{{/if}}"
    >
      <svg class="event-card__favorite-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.8 4.6a5.4 5.4 0 0 0-7.6 0L12 5.8l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.8a5.4 5.4 0 0 0 0-7.6Z" />
      </svg>
    </button>
    <span class="event-card__image-frame" style="--event-card-image-bg: url('{{imageUrl}}');">
      <img
        src="{{imageUrl}}"
        alt="{{title}}"
        class="event-card__image"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        onerror="this.onerror=null;this.src='/public/static/img/concert.jpeg';"
      />
    </span>
    <h3 class="event-card__title">{{title}}</h3>

    {{#each textLines}}
      <p class="event-card__text">{{this}}</p>
    {{/each}}

    {{#if tags.length}}
      <div class="event-card__meta">
        <div class="event-card__tags-full">
          {{#each tags}}
            <span class="event-card__tag">{{this}}</span>
          {{/each}}
        </div>
        <div class="event-card__tags-mobile{{#if extraTagsCount}} event-card__tags-mobile--with-count{{/if}}">
          <span class="event-card__tag">{{primaryTag}}</span>
          {{#if extraTagsCount}}
            <span class="event-card__tag event-card__tag--count">+{{extraTagsCount}}</span>
          {{/if}}
        </div>
      </div>
    {{/if}}
  </a>
{{else}}
  <div class="event-card {{cardClass}}">
    <button
      type="button"
      class="event-card__favorite{{#if isFavorite}} event-card__favorite--active{{/if}}"
