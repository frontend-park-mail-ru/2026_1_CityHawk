<div class="site-header">
  <div class="site-header__container">
    <div class="site-header__row">
      <div class="site-header__left">
        <div class="site-header__menu" data-role="header-menu">
          <button
            type="button"
            class="site-header__menu-trigger"
            aria-label="Открыть меню"
            aria-haspopup="menu"
            aria-expanded="false"
            data-role="header-menu-trigger"
          >
            <img src="/public/static/icons/menu.svg" alt="" class="site-header__menu-icon" aria-hidden="true" />
          </button>

          <aside class="site-header__sidebar" aria-label="Навигационное меню" data-role="header-menu-sidebar">
            <nav class="site-header__sidebar-nav">
              <div class="site-header__sidebar-group">
                <h3 class="site-header__sidebar-group-title">Навигация</h3>
                <a href="/" class="site-header__sidebar-link">Главная</a>
                <a href="/events" class="site-header__sidebar-link">Все события</a>
                <a href="/events-map" class="site-header__sidebar-link">Карта</a>
              </div>

              <div class="site-header__sidebar-group">
                <h3 class="site-header__sidebar-group-title">Система</h3>
                <a
                  href="/support-widget"
                  class="site-header__sidebar-link"
                  data-action="open-support-launcher"
                >Поддержка</a>
                <a href="/events/new" class="site-header__sidebar-link">Создать событие</a>
              </div>
            </nav>
          </aside>
        </div>

        <a href="/" class="site-header__brand" aria-label="CityHawk">
          <span class="site-header__brand-mark" aria-hidden="true"></span>
          <span class="site-header__brand-text">CityHawk</span>
        </a>
      </div>

      <div class="site-header__main">
        <div class="site-header__city" data-role="header-city">
          <button
            type="button"
            class="site-header__link site-header__link--with-icon site-header__link--button site-header__city-trigger"
            data-role="header-city-trigger"
            aria-label="Выбрать город"
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <img src="/public/static/icons/location.svg" alt="" class="site-header__link-icon" aria-hidden="true" />
            <span data-role="header-city-label">Москва</span>
          </button>
          <div class="site-header__city-menu" data-role="header-city-menu" hidden>
            <div data-role="header-city-options"></div>
          </div>
        </div>

        {{#if headerSearch}}
          <div class="site-header__search-wrap" data-role="header-search-wrap">
            <form class="site-header__search" data-role="header-search-form">
              <input
                type="text"
                name="query"
                class="site-header__search-input"
                placeholder="Найти события"
                value="{{headerSearch.query}}"
                autocomplete="off"
              />
              <button class="site-header__search-button" type="submit" aria-label="Поиск">
                <img src="/public/static/icons/search.svg" alt="" class="site-header__search-icon" aria-hidden="true" />
              </button>
            </form>
            <div
              class="site-header__search-suggestions"
              data-role="header-search-suggestions"
              hidden
            ></div>
          </div>
        {{/if}}
      </div>

      <div class="site-header__actions">
        <div class="site-header__notifications" data-role="header-notifications">
            <button
              type="button"
              class="site-header__notifications-trigger"
              aria-label="Открыть уведомления"
              aria-haspopup="dialog"
              aria-expanded="false"
              data-role="header-notifications-trigger"
            >
              <svg class="site-header__notifications-bell" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15.4 17.4a3.5 3.5 0 0 1-6.8 0" />
                <path d="M5.4 16.2h13.2l-1.2-2.1v-3.6a5.4 5.4 0 0 0-10.8 0v3.6l-1.2 2.1Z" />
              </svg>
              <span class="site-header__notifications-count" data-role="header-notifications-count" aria-hidden="true" hidden>0</span>
            </button>

            <section
              class="site-header__notifications-panel"
              aria-label="Уведомления"
              data-role="header-notifications-panel"
            >
              <header class="site-header__notifications-header">
                <svg class="site-header__notifications-title-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M15.4 17.4a3.5 3.5 0 0 1-6.8 0" />
                  <path d="M5.4 16.2h13.2l-1.2-2.1v-3.6a5.4 5.4 0 0 0-10.8 0v3.6l-1.2 2.1Z" />
                </svg>
                <h2 class="site-header__notifications-title">Уведомления</h2>
              </header>

              <div class="site-header__notifications-tabs" role="tablist" aria-label="Фильтр уведомлений">
                <button type="button" class="site-header__notifications-tab site-header__notifications-tab--active" data-role="header-notifications-tab" data-notification-filter="all">Все</button>
                <button type="button" class="site-header__notifications-tab" data-role="header-notifications-tab" data-notification-filter="unread">Непрочитанные</button>
                <button type="button" class="site-header__notifications-tab" data-role="header-notifications-tab" data-notification-filter="read">Прочитанные</button>
              </div>

              <div class="site-header__notifications-list" data-role="header-notifications-list"></div>
            </section>
        </div>

        {{#if user}}
          <div class="site-header__user-menu">
            <button
              type="button"
              class="site-header__link site-header__link--with-icon site-header__link--button site-header__user"
              aria-haspopup="menu"
              aria-expanded="false"
              data-role="header-user-menu-trigger"
            >
              <img src="/public/static/icons/person.svg" alt="" class="site-header__link-icon" aria-hidden="true" />
              <span>{{user.displayName}}</span>
            </button>
            <div class="site-header__user-dropdown" aria-label="Меню пользователя">
              <a href="/profile" class="site-header__user-dropdown-link">Профиль</a>
              <a href="/profile/settings" class="site-header__user-dropdown-link">Настройки</a>
              <a href="/profile" class="site-header__user-dropdown-link">Найти друзей</a>
              <a href="/login" class="site-header__user-dropdown-link site-header__user-dropdown-link--exit">Выход</a>
            </div>
          </div>
        {{else}}
          <a href="/login" class="site-header__signin ui-button ui-button--secondary ui-button--pill">Войти</a>
        {{/if}}
      </div>
    </div>
  </div>
</div>
