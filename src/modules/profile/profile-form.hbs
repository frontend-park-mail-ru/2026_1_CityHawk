<section class="profile__content">
    <div class="profile__wrapper">
        <a href="/" class="login__close" aria-label="На главную">
            <svg width="454" height="453" viewBox="0 0 454 453" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M441.304 385.652C456.956 401.304 456.956 425.652 441.304 441.304C433.478 449.13 423.913 452.609 413.478 452.609C403.043 452.609 393.478 449.13 385.652 441.304L226.522 282.174L67.3913 441.304C59.5652 449.13 50 452.609 39.5652 452.609C29.1304 452.609 19.5652 449.13 11.7391 441.304C-3.91304 425.652 -3.91304 401.304 11.7391 385.652L170.87 226.522L11.7391 67.3913C-3.91304 51.7391 -3.91304 27.3913 11.7391 11.7391C27.3913 -3.91304 51.7391 -3.91304 67.3913 11.7391L226.522 170.87L385.652 11.7391C401.304 -3.91304 425.652 -3.91304 441.304 11.7391C456.956 27.3913 456.956 51.7391 441.304 67.3913L282.174 226.522L441.304 385.652Z" fill="currentColor"/>
            </svg>
        </a>
        <h1 class="profile__title">Настройки профиля</h1>

        <form class="profile__form" method="post" action="/profile/settings">
            <div class="profile__avatar-section">
                <div class="profile__avatar-wrapper profile__avatar-wrapper--form">
                    {{#if user.avatarUrl}}
                    <img
                        class="profile__avatar profile__avatar--form"
                        src="{{user.avatarUrl}}"
                        alt="Аватар пользователя"
                    >
                    {{else}}
                    <div class="profile__avatar profile__avatar--fallback profile__avatar--form" aria-label="Аватар пользователя">
                        <span class="profile__avatar-initials">{{user.initials}}</span>
                    </div>
                    {{/if}}
                </div>

                {{#if enableAvatarUpload}}
                <button class="profile__avatar-edit profile__avatar-edit--form" type="button">
                    Изменить фото
                </button>
                <input
                    type="file"
                    accept="image/*"
                    hidden
                    data-role="profile-avatar-input"
                />
                {{/if}}
            </div>

            {{> form-input
                fieldClass="profile__field"
                label="Имя"
                type="text"
                id="firstName"
                name="firstName"
                placeholder="Имя"
                value=user.firstName
                errorClass="form-field__error profile__name-error"
            }}

            {{> form-input
                fieldClass="profile__field profile__field--email"
                label="Email"
                type="email"
                id="email"
                name="email"
                placeholder="address@service.com"
                value=user.email
                inputClass="profile__email-input"
                errorClass="form-field__error profile__email-error"
            }}

            <div class="profile__grid profile__grid--two">
                {{> form-input
                    fieldClass="profile__field"
                    label="Дата рождения"
                    type="date"
                    id="birthdate"
                    name="birthdate"
                    value=user.birthdate
                }}

                {{> form-select
                    fieldClass="profile__field"
                    label="Город"
                    id="city"
                    name="city"
                    options=user.cityOptions
                }}
            </div>

            <label class="profile__field profile__field--full">
                <span class="profile__label">Описание</span>
                <textarea
                    class="profile__textarea"
                    id="bio"
                    name="bio"
                    placeholder="Расскажите о себе"
                >{{user.bio}}</textarea>
            </label>

            <label class="profile__field profile__field--full">
                <span class="profile__label">Интересы</span>
                <div class="profile__interests" data-role="profile-interests-picker">
                    <input
                        type="text"
                        class="profile__interests-input"
                        data-role="profile-interests-input"
                        list="profile-interest-options"
                        placeholder="Выберите интересы из списка"
                    />
                    <div class="profile__interests-selected" data-role="profile-interests-selected"></div>
                    <input
                        type="hidden"
                        name="interests"
                        data-role="profile-interests-hidden"
                        value="{{user.interestIdsCsv}}"
                    />
                </div>
                <datalist id="profile-interest-options" data-role="profile-interest-options">
                    {{#each user.interestOptions}}
                    <option value="{{this.label}}" data-id="{{this.value}}"></option>
                    {{/each}}
                </datalist>
            </label>

            <div class="profile__account-actions">
                <button class="profile__logout-link ui-button ui-button--link" type="button">Выйти из аккаунта</button>
            </div>

            <div class="profile__actions">
                <button class="profile__button profile__button--secondary ui-button ui-button--ghost ui-button--pill" type="reset">Отменить</button>
                <button class="profile__button profile__button--primary ui-button ui-button--primary ui-button--pill" type="submit">Сохранить</button>
            </div>
        </form>
    </div>
</section>
