<section class="event-location">
  <div class="event-location__container">
    <div class="event-location__grid">
      <div class="event-location__info">
        <h2 class="event-location__title">Как добраться?</h2>

        <div class="event-location__text">
          {{#each paragraphs}}
            <p class="event-location__paragraph">{{this}}</p>
          {{/each}}
        </div>
      </div>

      <div class="event-location__map" data-role="event-location-map" data-latitude="{{mapLatitude}}" data-longitude="{{mapLongitude}}" data-map-title="{{mapTitle}}">
        {{#if hasMapCoordinates}}
          <div class="event-location__map-canvas" data-role="event-location-map-canvas" aria-label="{{mapAlt}}"></div>
          <div class="event-location__map-fallback" data-role="event-location-map-fallback" hidden>
            <img src="{{mapImageUrl}}" alt="{{mapAlt}}" class="event-location__map-image" />
            <span class="event-location__map-pin"></span>
            <span class="event-location__map-fallback-text">Карта недоступна оффлайн</span>
          </div>
        {{else}}
          <img src="{{mapImageUrl}}" alt="{{mapAlt}}" class="event-location__map-image" />
          <span class="event-location__map-pin"></span>
        {{/if}}
      </div>
    </div>
  </div>

  <div class="event-location__modal" data-role="event-location-modal" hidden>
    <button type="button" class="event-location__modal-backdrop" data-role="event-location-modal-close" aria-label="Закрыть карту"></button>
    <section class="event-location__modal-dialog" role="dialog" aria-modal="true" aria-label="Карта события">
      <button type="button" class="event-location__modal-close" data-role="event-location-modal-close" aria-label="Закрыть карту">×</button>
      {{#if hasMapCoordinates}}
        <div class="event-location__modal-canvas" data-role="event-location-modal-canvas" aria-label="{{mapAlt}}"></div>
        <div class="event-location__modal-fallback" data-role="event-location-modal-fallback" hidden>
          <img src="{{mapImageUrl}}" alt="{{mapAlt}}" class="event-location__modal-image" />
        </div>
      {{else}}
        <img src="{{mapImageUrl}}" alt="{{mapAlt}}" class="event-location__modal-image" />
      {{/if}}
    </section>
  </div>
</section>
