<section class="event-hero" style="--event-hero-bg: url('{{posterUrl}}');">
  <div class="event-hero__container">
    <div class="event-hero__grid">
      <div class="event-hero__content">
        {{#if category}}
          <p class="event-hero__eyebrow">{{category}}</p>
        {{/if}}

        <h1 class="event-hero__title">{{title}}</h1>

        <div class="event-hero__meta">
          {{#if dateText}}
            <p class="event-hero__meta-text">{{dateText}}</p>
          {{/if}}
          {{#if placeText}}
            <p class="event-hero__meta-text">{{placeText}}</p>
          {{/if}}
        </div>

        <div class="event-hero__actions">
          <button type="button" class="event-hero__action" data-action="event-invite-open">
            <svg class="event-hero__action-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 20a6 6 0 0 0-12 0" />
              <circle cx="9" cy="7" r="4" />
              <path d="M19 8v6" />
              <path d="M16 11h6" />
            </svg>
            Пригласить
          </button>

          <button
            type="button"
            class="event-hero__action event-hero__action--primary"
            data-action="event-share-open"
            data-share-url="{{shareUrl}}"
          >
            <svg class="event-hero__action-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="18" cy="5" r="3" />
              <circle cx="6" cy="12" r="3" />
              <circle cx="18" cy="19" r="3" />
              <path d="M8.6 10.6 15.4 6.4" />
              <path d="M8.6 13.4 15.4 17.6" />
            </svg>
            Поделиться
          </button>

          <button
            type="button"
            class="event-hero__action event-hero__action--icon{{#if isFavorite}} event-hero__action--favorite-active{{/if}}"
            data-role="event-hero-favorite"
            data-event-id="{{eventId}}"
            aria-label="{{#if isFavorite}}Убрать из избранного{{else}}Добавить в избранное{{/if}}"
            aria-pressed="{{#if isFavorite}}true{{else}}false{{/if}}"
          >
            <svg class="event-hero__action-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.8 4.6a5.4 5.4 0 0 0-7.6 0L12 5.8l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.8a5.4 5.4 0 0 0 0-7.6Z" />
            </svg>
          </button>
        </div>
      </div>

      <div class="event-hero__poster {{posterClass}}">
        <img src="{{posterUrl}}" alt="{{title}}" class="event-hero__poster-image" />
      </div>
    </div>
  </div>
</section>
